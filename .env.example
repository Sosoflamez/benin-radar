DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://benin_radar:benin_radar@localhost:5432/benin_radar

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Règles métier
SPEED_TOLERANCE_KMH=5
DETECTION_RETENTION_DAYS=7

# Pipeline vision (Phase 2)
YOLO_MODEL_WEIGHTS=yolov8n.pt
PIPELINE_SAMPLE_FPS=15
DETECTION_CONFIDENCE_THRESHOLD=0.4
TRACKING_CONFIDENCE_THRESHOLD=0.5

# ANPR (Phase 3)
ANPR_EASYOCR_GPU=False

# Ingestion RTSP (Phase 4)
PIPELINE_TRACK_TIMEOUT_S=3.0
